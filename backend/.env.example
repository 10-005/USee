# 복사해서 backend/.env로 사용 (cp .env.example .env). .env는 커밋하지 않는다.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=animal
DB_USERNAME=animal
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# JWT 검증용 RS256 공개키 (Base64 X.509 DER 한 줄). 생성 방법은 README 참고
JWT_PUBLIC_KEY=
# JWT 발급용 RS256 개인키 (Base64 PKCS#8 DER 한 줄, core-api만 사용). 생성 방법은 README 참고
JWT_PRIVATE_KEY=

# 서비스 간 이벤트: log(기본, 로그만) 또는 rabbit. rabbit이면 docker compose의 RabbitMQ로 보낸다
EVENTS_TRANSPORT=log
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=animal
RABBITMQ_PASSWORD=change-me
