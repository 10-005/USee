[Unit]
Description=Upload an encrypted snapshot of deployed Registry images
Wants=network-online.target
After=network-online.target k3s.service
AssertPathExists=/etc/s15-k3s-backup/recipients

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/s15-registry-backup/registry-backup.py
ExecStopPost=/usr/bin/rm -f /var/cache/s15-registry-backup/snapshot.tar.age
LoadCredentialEncrypted=aws:/etc/s15-registry-backup/aws.cred
Environment=AWS_SHARED_CREDENTIALS_FILE=%d/aws
Environment=AWS_CONFIG_FILE=/dev/null
Environment=AWS_EC2_METADATA_DISABLED=true
CacheDirectory=s15-registry-backup
CacheDirectoryMode=0700
StateDirectory=s15-registry-backup
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=45min
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
