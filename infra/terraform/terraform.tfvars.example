# 이 파일을 terraform.tfvars 로 복사해서 값을 채운다.
# terraform.tfvars 는 비밀값이 들어가므로 Git에 올리지 않는다 (.gitignore 처리됨).

# 비상용 SSH 허용 IP. 확인: curl -s https://checkip.amazonaws.com
# 집·교육장처럼 장소가 바뀌면 추가하고 apply (보안 그룹 규칙만 바뀜)
ssh_allowed_cidrs = ["1.2.3.4/32"]

# Tailscale 관리 화면에서 발급 (재사용 불가, 7일, tag:k3s)
tailscale_auth_key = "tskey-auth-..."

# 노드 1에서: sudo k3s token create --ttl 24h --description node2
k3s_token = "K10..."

budget_email = "you@example.com"

# 참고: 노드 2가 만들어진 뒤에는 user_data 변경을 무시하므로,
# 다른 PC에서는 tailscale_auth_key / k3s_token 에 아무 값이나 넣어도 된다.
